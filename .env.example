# Which provider src/llm_provider.py should use: "anthropic" or "local"
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Local / OpenAI-compatible endpoint (used when LLM_PROVIDER=local)
# Long-term target: the MacBook Air M4 running Ollama, reachable over LAN.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# X/Twitter (not needed yet for reply-pipeline testing)
TWITTER_USERNAME=
TWITTER_PASSWORD=
