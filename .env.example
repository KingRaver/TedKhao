# Which provider src/llm_provider.py should use: "anthropic" or "local"
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Local / OpenAI-compatible endpoint (used when LLM_PROVIDER=local)
# Long-term target: the MacBook Air M4 running Ollama, reachable over LAN.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# X/Twitter (not needed yet for reply-pipeline testing)
TWITTER_USERNAME=
TWITTER_PASSWORD=

# SQLite database path (created on first run if it doesn't exist). Default is fine for
# local development -- override only for a non-standard data location.
DATABASE_PATH=data/tedkhao.db

# bot.py orchestration (Phase 7). Defaults target ~6 cycles/day, within docs/SPEC.md's
# "3-6 original posts a day" user story.
CYCLE_INTERVAL_MINUTES=240
REPLY_MAX_PER_CYCLE=3

# Publishing to X is irreversible -- leave false (dry run: generate + persist only) until
# TWITTER_USERNAME/TWITTER_PASSWORD above are set and you've deliberately decided to go live.
# bot.py's --live flag does the same thing for a single run without changing this default.
LIVE_POSTING_ENABLED=false
